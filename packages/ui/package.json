  "devDependencies": {
    "@devtools/hooks": "workspace:*",
    "@devtools/libs": "workspace:*",
    "@devtools/utils": "workspace:*",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@devtools/shared": "workspace:*",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "shadcn": "^4.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
