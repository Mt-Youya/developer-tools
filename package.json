{
  "name": "developer-tools",
  "version": "0.0.1",
  "description": "developer tools for developing use",
  "type": "module",
  "scripts": {
    "dev": "pnpm -F dev-tools dev",
    "serve": "pnpm -F api dev",
    "build": "pnpm -F ui build && pnpm -r run build",
    "preview": "pnpm build && pnpm -F dev-tools preview",
    "lint": "biome check packages apps",
    "lint:fix": "biome check --write packages apps",
    "lint:fix-unsafe": "biome check --write packages apps --unsafe",
    "lint:oxlint": "oxlint packages apps",
    "format": "biome format --write packages apps",
    "check": "pnpm lint:fix && pnpm lint:oxlint",
    "typecheck": "pnpm -r --parallel typecheck",
    "ci": "pnpm lint && pnpm lint:oxlint && pnpm typecheck",
    "fix": "pnpm lint:fix && pnpm typecheck",
    "lint:staged": "biome check --write --staged --no-errors-on-unmatched",
    "clean": "rm -rf node_modules && pnpm -r exec rm -rf dist node_modules",
    "get-directory": "node scripts/generateDirectoryTree.ts",
    "add-shadcn-comp": "node scripts/autoCreateShadcnComp.ts",
    "update-pkg": "node scripts/updatePkg.ts",
    "remove-pkg": "node scripts/removePkg.ts",
    "upgrade:all": "pnpm up -rL",
    "upgrade:latest": "pnpm -r update --latest",
    "manager-update": "corepack prepare pnpm@latest --activate"
  },
  "keywords": [],
  "author": "Yonjay Doyle",
  "license": "ISC",
  "dependencies": {
    "@devtools/libs": "workspace:*",
    "@devtools/utils": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.1",
    "lodash-es": "^4.17.22",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shared": "^0.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "vite-plugin-babel": "^1.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/ui": "^4.0.16",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "oxlint": "^1.35.0",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-oxlint": "^0.7.5",
    "vite": "^7.3.0",
    "vite-plugin-inspect": "^11.3.3",
    "vitest": "^4.0.16"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.2.0",
      "react-dom": "^19.2.0"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
