{
  "name": "developer-tools",
  "version": "0.0.1",
  "description": "developer tools for developing use",
  "type": "module",
  "scripts": {
    "dev": "pnpm -F dev-tools dev",
    "serve": "pnpm -F api dev",
    "build": "pnpm -F ui build && pnpm -r run build",
    "preview": "pnpm build && pnpm -F dev-tools preview",
    "lint": "biome check packages apps",
    "lint:fix": "biome check --write packages apps",
    "lint:fix-unsafe": "biome check --write packages apps --unsafe",
    "lint:oxlint": "oxlint packages apps",
    "format": "biome format --write packages apps",
    "check": "pnpm lint:fix && pnpm lint:oxlint",
    "typecheck": "pnpm -r --parallel typecheck",
    "ci": "pnpm lint && pnpm lint:oxlint && pnpm typecheck",
    "fix": "pnpm lint:fix && pnpm typecheck",
    "lint:staged": "biome check --write --staged --no-errors-on-unmatched",
    "clean": "rm -rf node_modules pnpm-lock.yaml && pnpm -r exec rm -rf dist node_modules .vite-inspect pnpm-lock.yaml",
    "clean:dev": "pnpm clean && pnpm i && pnpm dev",
    "get-directory": "node scripts/generateDirectoryTree.ts",
    "add-shadcn-comp": "node scripts/autoCreateShadcnComp.ts",
    "update-pkg": "node scripts/updatePkg.ts",
    "remove-pkg": "node scripts/removePkg.ts",
    "upgrade:all": "pnpm up -rL",
    "upgrade:latest": "pnpm -rL update --latest",
    "manager-update": "corepack prepare pnpm@latest --activate"
  },
  "keywords": [],
  "author": "Yonjay Doyle",
  "license": "ISC",
  "dependencies": {
    "@devtools/libs": "workspace:*",
    "@devtools/utils": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.1",
    "lodash-es": "^4.17.23",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shared": "^0.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "oxlint": "^1.57.0",
    "typescript": "^6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-oxlint": "^0.8.0",
    "vite": "^8.0.3",
    "vite-plugin-inspect": "12.0.0-beta.1",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "bson": "^7.2.0",
      "underscore": "^1.13.7",
      "@isaacs/brace-expansion": "^5.0.1",
      "mongodb": "^7.1.0",
      "node-uuid": "^1.4.8",
      "hono": "^4.11.7",
      "keygrip": "^1.1.0",
      "node-domexception": "^1.0.0",
      "@tensorflow/tfjs-core": "^4.22.0",
      "@tensorflow/tfjs-converter": "^4.22.0"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
